{
  "rules": {
    "stats": {
      ".read": "auth != null",
      "$key": {
        ".write": "auth != null && newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() === data.val() + 1)"
      }
    },
    "lobby": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null && (!data.exists() || data.child('hostId').val() === auth.uid || newData.val() === null)"
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('hostId').val() === auth.uid || newData.val() === null)"
        },
        "cmd": {
          ".write": "auth != null"
        },
        "world": {
          ".write": "auth != null && (!root.child('rooms/'+$roomId+'/meta/hostId').exists() || root.child('rooms/'+$roomId+'/meta/hostId').val() === auth.uid || newData.val() === null)"
        },
        "pads": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid"
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('rooms/'+$roomId+'/meta/hostId').val() === auth.uid || newData.val() === null)"
          }
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && $uid === auth.uid"
      }
    },
    "chats": {
      ".read": "auth != null",
      "$chatId": {
        ".write": "auth != null",
        "messages": {
          "$msgId": {
            ".write": "auth != null"
          }
        },
        "members": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        "requests": {
          "$uid": {
            ".write": "auth != null"
          }
        }
      }
    }
  }
}
